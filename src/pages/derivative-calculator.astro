---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EquationSolver from '@/components/solver/EquationSolver';

const title = 'Derivative Calculator with Steps — d/dx Solver | EasyEquate';
const description = 'Free derivative calculator with steps. Differentiate any function step-by-step with Power Rule, Product Rule, Quotient Rule, and Chain Rule explained.';
const canonical = 'https://www.easyequate.com/derivative-calculator';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "EasyEquate Derivative Calculator",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does this derivative calculator show steps?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The solver breaks down your expression term-by-term, identifying the exact calculus rule used and displaying the intermediate substitution."
          }
        },
        {
          "@type": "Question",
          "name": "What is the power rule for derivatives?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The power rule states that d/dx [x^n] = n * x^(n - 1). For example, the derivative of x³ is 3x²."
          }
        },
        {
          "@type": "Question",
          "name": "Can it differentiate trigonometric and logarithmic functions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, it supports sin(x), cos(x), tan(x), ln(x), e^x, and combinations using the product, quotient, and chain rules."
          }
        },
        {
          "@type": "Question",
          "name": "Can I calculate second and higher-order derivatives?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, you can apply differentiation successively to calculate f''(x) and higher derivatives."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <div class="w-full text-[#131313] dark:text-[#F5F5F5] py-1">
    <div class="max-w-6xl xl:max-w-7xl mx-auto space-y-3 sm:space-y-5">
      <header class="space-y-1 sm:space-y-1.5 text-center sm:text-left pt-10 sm:pt-0 sm:pl-36 md:pl-44">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-[#EFEBE9] dark:bg-[#25201E] border border-[#D7CCC8] dark:border-[#3E2723] text-[10px] sm:text-xs font-mono font-bold text-[#5D4037] dark:text-[#D7CCC8]">
          <span>CALCULUS ENGINE</span>
          <span>•</span>
          <span>DIFFERENTIATION WITH STEPS</span>
        </div>
        <h1 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-[#131313] dark:text-white">
          Derivative Calculator with Steps
        </h1>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] max-w-3xl">
          Differentiate any single-variable function step-by-step. Displays the power rule, product rule, quotient rule, and chain rule with complete algebraic substitutions.
        </p>
      </header>

      <section class="w-full">
        <EquationSolver client:load initialMode="derivative" initialEquation="x^3 - 4x^2 + 7x - 5" hideHeader wideLayout />
      </section>

      <section class="bg-white dark:bg-[#1B1B1B] p-4 sm:p-6 rounded-2xl border border-[#E0E0E0] dark:border-[#2E2825] shadow-xs space-y-3">
        <h2 class="text-base sm:text-lg font-bold text-[#131313] dark:text-white">Mastering Differentiation</h2>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] leading-relaxed">
          The derivative measures the instantaneous rate of change of a function with respect to its variable, geometrically representing the slope of the tangent line to the curve at any point.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-center sm:text-left text-[#131313] dark:text-white">Frequently Asked Questions</h2>
        <div class="space-y-3">
          <div class="bg-white dark:bg-[#3E2723] p-4 rounded-lg border border-[#E0E0E0] dark:border-[#5D4037]">
            <h3 class="font-semibold text-lg">How does this derivative calculator show steps?</h3>
            <p class="mt-2 opacity-90">The solver breaks down your expression term-by-term, identifying the exact calculus rule used and displaying the intermediate substitution.</p>
          </div>
          <div class="bg-white dark:bg-[#3E2723] p-4 rounded-lg border border-[#E0E0E0] dark:border-[#5D4037]">
            <h3 class="font-semibold text-lg">What is the power rule for derivatives?</h3>
            <p class="mt-2 opacity-90">The power rule states that d/dx [x^n] = n * x^(n - 1). For example, the derivative of x³ is 3x².</p>
          </div>
          <div class="bg-white dark:bg-[#3E2723] p-4 rounded-lg border border-[#E0E0E0] dark:border-[#5D4037]">
            <h3 class="font-semibold text-lg">Can it differentiate trigonometric and logarithmic functions?</h3>
            <p class="mt-2 opacity-90">Yes, it supports sin(x), cos(x), tan(x), ln(x), e^x, and combinations using the product, quotient, and chain rules.</p>
          </div>
        </div>
      </section>

      <footer class="text-center space-y-4 pt-8 border-t border-[#E0E0E0] dark:border-[#5D4037]">
        <h3 class="text-xl font-medium">Explore Other Solvers</h3>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/integral-calculator" class="text-blue-600 dark:text-blue-400 hover:underline">Integral Calculator</a>
          <a href="/equation-solver-with-steps" class="text-blue-600 dark:text-blue-400 hover:underline">Equation Solver with Steps</a>
          <a href="/graph" class="text-blue-600 dark:text-blue-400 hover:underline">Graph Plotter</a>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>
