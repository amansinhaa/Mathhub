---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EquationSolver from '@/components/solver/EquationSolver';

const title = 'Derivative Calculator with Steps — d/dx Solver | EasyEquate';
const description = 'Free derivative calculator with steps. Differentiate any function step-by-step with Power Rule, Product Rule, Quotient Rule, and Chain Rule explained.';
const canonical = 'https://www.easyequate.com/derivative-calculator';

const faqs = [
  {
    q: "How does this derivative calculator show steps?",
    a: "The solver breaks down your expression term-by-term, identifying the exact calculus rule used and displaying the intermediate substitution."
  },
  {
    q: "What is the power rule for derivatives?",
    a: "The power rule states that d/dx [x^n] = n * x^(n - 1). For example, the derivative of x³ is 3x²."
  },
  {
    q: "Can it differentiate trigonometric and logarithmic functions?",
    a: "Yes, it supports sin(x), cos(x), tan(x), ln(x), e^x, and combinations using the product, quotient, and chain rules."
  },
  {
    q: "Can I calculate second and higher-order derivatives?",
    a: "Yes, you can apply differentiation successively to calculate f''(x) and higher derivatives."
  },
  {
    q: "When do you use the product rule versus the chain rule?",
    a: "Use the product rule when two distinct variable functions are multiplied together, such as x² · sin(x). Use the chain rule when one function is nested inside another (composite function), such as sin(x²) or (3x + 1)⁵, where an 'outside' function wraps an 'inside' function."
  },
  {
    q: "Why is the derivative of a constant number always zero?",
    a: "The derivative represents the instantaneous rate of change (the slope) of a function. A constant value like f(x) = 5 is a flat, horizontal line with zero slope. Because the value never changes as x varies, its rate of change is identically zero: d/dx [c] = 0."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "EasyEquate Derivative Calculator",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <div class="w-full text-[#131313] dark:text-[#F5F5F5] py-1">
    <div class="max-w-6xl xl:max-w-7xl mx-auto space-y-3 sm:space-y-5">
      <header class="space-y-1 sm:space-y-1.5 text-left pt-11 sm:pt-0 sm:pl-36 md:pl-44 px-1 sm:px-0">
        <div class="hidden sm:block text-[10px] sm:text-xs font-mono font-semibold uppercase tracking-wider text-[#757575] dark:text-[#A19891]">
          Calculus Engine &bull; Differentiation with Steps
        </div>
        <h1 class="text-lg sm:text-2xl md:text-3xl font-bold tracking-tight text-[#131313] dark:text-white">
          Derivative Calculator
        </h1>
        <p class="hidden sm:block text-xs sm:text-sm text-[#616161] dark:text-[#A19891] max-w-3xl">
          Differentiate any single-variable function step-by-step. Displays the power rule, product rule, quotient rule, and chain rule with complete algebraic substitutions.
        </p>
      </header>

      <section class="w-full">
        <EquationSolver client:load initialMode="derivative" hideHeader wideLayout />
      </section>

      <section class="bg-white dark:bg-[#1B1B1B] p-4 sm:p-6 rounded-2xl border border-[#E0E0E0] dark:border-[#2E2825] shadow-xs space-y-3">
        <h2 class="text-base sm:text-lg font-bold text-[#131313] dark:text-white">Mastering Differentiation</h2>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] leading-relaxed">
          The derivative measures the instantaneous rate of change of a function with respect to its variable, geometrically representing the slope of the tangent line to the curve at any point.
        </p>
      </section>

      <section class="space-y-3 sm:space-y-4">
        <h2 class="text-base sm:text-xl font-bold text-[#131313] dark:text-white">Frequently Asked Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {faqs.map(faq => (
            <div class="p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] space-y-1.5">
              <h3 class="text-xs sm:text-sm font-bold text-[#131313] dark:text-white">{faq.q}</h3>
              <p class="text-xs text-[#616161] dark:text-[#A19891] leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <footer class="text-center space-y-4 pt-8 border-t border-[#E0E0E0] dark:border-[#5D4037]">
        <h3 class="text-xl font-medium">Explore Other Solvers</h3>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/integral-calculator" class="text-blue-600 dark:text-blue-400 hover:underline">Integral Calculator</a>
          <a href="/equation-solver-with-steps" class="text-blue-600 dark:text-blue-400 hover:underline">Equation Solver with Steps</a>
          <a href="/graph" class="text-blue-600 dark:text-blue-400 hover:underline">Graph Plotter</a>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>
