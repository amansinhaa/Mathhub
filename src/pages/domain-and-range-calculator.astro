---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EquationSolver from '@/components/solver/EquationSolver';
import AdBanner from '@/components/ads/AdBanner.astro';

const title = 'Domain and Range Calculator | EasyEquate';
const description = 'Find the domain and range of any function step-by-step in exact interval notation. Handles polynomials, fractions, radicals, logs, and trig functions.';
const canonical = 'https://www.easyequate.com/domain-and-range-calculator';

const faqs = [
  {
    q: "What is the domain of a function?",
    a: "The domain is the set of all possible input values (x-values) for which the function is defined and produces a real number output."
  },
  {
    q: "What is the range of a function?",
    a: "The range is the complete set of all resulting output values (y-values) that the function can produce across its entire domain."
  },
  {
    q: "How do you write domain and range in interval notation?",
    a: "Interval notation uses brackets [ ] for included endpoints and parentheses ( ) for excluded values and infinity. For example, [0, ∞) means all numbers greater than or equal to 0."
  },
  {
    q: "What causes values to be excluded from the domain?",
    a: "The two most common restrictions in real-valued functions are division by zero (denominators cannot equal zero) and negative values inside even roots (radicands must be ≥ 0)."
  },
  {
    q: "What are the domain and range of 1/x and √x?",
    a: "For f(x) = 1/x, the domain and range are both (-∞, 0) ∪ (0, ∞). For f(x) = √x, the domain and range are both [0, ∞)."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Easy Equate Domain and Range Calculator",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <div class="w-full text-[#131313] dark:text-[#F5F5F5] py-1">
    <div class="max-w-6xl xl:max-w-7xl mx-auto space-y-3 sm:space-y-5">
      <header class="space-y-1 sm:space-y-1.5 text-left pt-11 sm:pt-0 sm:pl-36 md:pl-44 px-1 sm:px-0">
        <div class="hidden sm:inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-[#EFEBE9] dark:bg-[#25201E] border border-[#D7CCC8] dark:border-[#3E2723] text-[10px] sm:text-xs font-mono font-bold text-[#5D4037] dark:text-[#D7CCC8]">
          <span>CALCULUS &amp; ALGEBRA</span>
          <span>•</span>
          <span>INTERVAL NOTATION</span>
        </div>
        <h1 class="text-lg sm:text-2xl md:text-3xl font-bold tracking-tight text-[#131313] dark:text-white">
          Domain and Range Calculator
        </h1>
        <p class="hidden sm:block text-xs sm:text-sm text-[#616161] dark:text-[#A19891] max-w-3xl">
          Find the exact domain and range of any function step-by-step in interval notation.
        </p>
      </header>

      <section class="w-full">
        <EquationSolver client:load initialMode="domain_range" initialEquation="sqrt(4 - x^2)" hideHeader wideLayout />
      </section>

      <AdBanner />

      <section class="bg-white dark:bg-[#1B1B1B] p-4 sm:p-6 rounded-2xl border border-[#E0E0E0] dark:border-[#2E2825] shadow-xs space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-[#131313] dark:text-white">How to Find Domain and Range</h2>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] leading-relaxed">
          To find the domain, identify values of <em>x</em> where the function is undefined—such as division by zero, square roots of negative numbers, or non-positive logarithm arguments.
          To find the range, analyze the function's minimum and maximum values, horizontal asymptotes, or invertibility.
        </p>
      </section>

      <section class="space-y-3 sm:space-y-4">
        <h2 class="text-base sm:text-xl font-bold text-[#131313] dark:text-white">Frequently Asked Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {faqs.map(faq => (
            <div class="p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] space-y-1.5">
              <h3 class="text-xs sm:text-sm font-bold text-[#131313] dark:text-white">{faq.q}</h3>
              <p class="text-xs text-[#616161] dark:text-[#A19891] leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <footer class="text-center space-y-4 pt-8 border-t border-[#E0E0E0] dark:border-[#5D4037]">
        <h3 class="text-base sm:text-lg font-bold text-[#131313] dark:text-white">Explore Related Solvers</h3>
        <div class="flex flex-wrap justify-center gap-3 text-xs sm:text-sm">
          <a href="/equation-solver-with-steps" class="text-[#5D4037] dark:text-[#D7CCC8] hover:underline">Equation Solver with Steps</a>
          <span class="text-[#BCAAA4]">•</span>
          <a href="/quadratic-equation-solver" class="text-[#5D4037] dark:text-[#D7CCC8] hover:underline">Quadratic Solver</a>
          <span class="text-[#BCAAA4]">•</span>
          <a href="/derivative-calculator" class="text-[#5D4037] dark:text-[#D7CCC8] hover:underline">Derivative Calculator</a>
          <span class="text-[#BCAAA4]">•</span>
          <a href="/graph" class="text-[#5D4037] dark:text-[#D7CCC8] hover:underline">Graph Studio</a>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>
