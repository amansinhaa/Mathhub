---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EquationSolver from '@/components/solver/EquationSolver';

const title = 'Integral Calculator with Steps — Calculus | EasyEquate';
const description = 'Free integral calculator with steps. Calculate indefinite and definite integrals step-by-step with power rule, substitution, and + C shown.';
const canonical = 'https://www.easyequate.com/integral-calculator';

const faqs = [
  {
    q: "Why is the constant + C added to integrals?",
    a: "For indefinite integrals, any constant term differentiates to zero. Therefore, there are infinitely many antiderivatives differing by a constant C, which represents this unknown constant."
  },
  {
    q: "What is the reverse power rule for integration?",
    a: "The power rule for integration is ∫ x^n dx = (x^(n + 1)) / (n + 1) + C (for n ≠ -1). If n = -1, the integral is ln|x| + C."
  },
  {
    q: "Can this solve definite integrals with bounds?",
    a: "Yes, enter limits to compute definite integrals using the Fundamental Theorem of Calculus: F(b) - F(a)."
  },
  {
    q: "What is the difference between an indefinite integral and a definite integral?",
    a: "An indefinite integral ∫ f(x) dx has no limits and represents the general family of antiderivatives, always including the constant of integration + C. A definite integral ∫[a to b] f(x) dx has specific integration bounds [a, b] and calculates a single numerical value representing the net signed area under the curve."
  },
  {
    q: "How do you solve integrals using u-substitution step by step?",
    a: "First, identify an inner function u = g(x) whose derivative du = g'(x) dx also appears in the integrand. Next, substitute u and du to rewrite the integral completely in terms of u. Evaluate the simpler integral, and finally replace u with the original variable expression g(x) (adding + C for indefinite integrals)."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "EasyEquate Integral Calculator",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <div class="w-full text-[#131313] dark:text-[#F5F5F5] py-1">
    <div class="max-w-6xl xl:max-w-7xl mx-auto space-y-3 sm:space-y-5">
      <header class="space-y-1 sm:space-y-1.5 text-center sm:text-left pt-10 sm:pt-0 sm:pl-36 md:pl-44">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-[#EFEBE9] dark:bg-[#25201E] border border-[#D7CCC8] dark:border-[#3E2723] text-[10px] sm:text-xs font-mono font-bold text-[#5D4037] dark:text-[#D7CCC8]">
          <span>CALCULUS ENGINE</span>
          <span>•</span>
          <span>INTEGRATION WITH CONSTANT OF INTEGRATION</span>
        </div>
        <h1 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-[#131313] dark:text-white">
          Integral Calculator with Steps
        </h1>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] max-w-3xl">
          Compute indefinite integrals (antiderivatives) and definite integrals step-by-step with formulas, substitution, and + C shown.
        </p>
      </header>

      <section class="w-full">
        <EquationSolver client:load initialMode="integral" initialEquation="2x + 1" hideHeader wideLayout />
      </section>

      <section class="bg-white dark:bg-[#1B1B1B] p-4 sm:p-6 rounded-2xl border border-[#E0E0E0] dark:border-[#2E2825] shadow-xs space-y-3">
        <h2 class="text-base sm:text-lg font-bold text-[#131313] dark:text-white">Understanding Integration</h2>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] leading-relaxed">
          Integration is the inverse operation of differentiation. An indefinite integral represents a family of functions whose derivative equals the integrand.
        </p>
      </section>

      <section class="space-y-3 sm:space-y-4">
        <h2 class="text-base sm:text-xl font-bold text-[#131313] dark:text-white">Frequently Asked Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {faqs.map(faq => (
            <div class="p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] space-y-1.5">
              <h3 class="text-xs sm:text-sm font-bold text-[#131313] dark:text-white">{faq.q}</h3>
              <p class="text-xs text-[#616161] dark:text-[#A19891] leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <footer class="text-center space-y-4 pt-8 border-t border-[#E0E0E0] dark:border-[#5D4037]">
        <h3 class="text-xl font-medium">Explore Other Solvers</h3>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/derivative-calculator" class="text-blue-600 dark:text-blue-400 hover:underline">Derivative Calculator</a>
          <a href="/equation-solver-with-steps" class="text-blue-600 dark:text-blue-400 hover:underline">Equation Solver with Steps</a>
          <a href="/graph" class="text-blue-600 dark:text-blue-400 hover:underline">Graph Plotter</a>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>
