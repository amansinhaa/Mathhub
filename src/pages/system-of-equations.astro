---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EquationSolver from '@/components/solver/EquationSolver';

const title = "System of Equations Solver with Steps | EasyEquate";
const description = "Free system of equations solver. Solves 2x2 and 3x3 linear systems step-by-step using Cramer's Rule, substitution, and Gaussian elimination. Free.";
const canonical = 'https://www.easyequate.com/system-of-equations';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does the system of equations solver work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Enter your equations separated by commas (e.g. 2x + y = 7, x - y = 2). The solver sets up the matrix form Ax = b and computes the determinant using Cramer's Rule or Gaussian elimination to find the exact intersection point."
          }
        },
        {
          "@type": "Question",
          "name": "Can it solve 3-variable systems?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, it supports systems with x, y, and z variables using row reduction and back-substitution."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if a system has no solution?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "When the determinant is zero, the solver identifies whether the lines are parallel (inconsistent / no solution) or coincident (infinitely many solutions)."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <div class="w-full text-[#131313] dark:text-[#F5F5F5] py-1">
    <div class="max-w-6xl xl:max-w-7xl mx-auto space-y-3 sm:space-y-5">
      <header class="space-y-1 sm:space-y-1.5 text-left pt-11 sm:pt-0 sm:pl-36 md:pl-44 px-1 sm:px-0">
        <div class="hidden sm:inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-[#EFEBE9] dark:bg-[#25201E] border border-[#D7CCC8] dark:border-[#3E2723] text-[10px] sm:text-xs font-mono font-bold text-[#5D4037] dark:text-[#D7CCC8]">
          <span>SIMULTANEOUS EQUATIONS</span>
          <span>•</span>
          <span>CRAMER'S RULE & ELIMINATION</span>
        </div>
        <h1 class="text-lg sm:text-2xl md:text-3xl font-bold tracking-tight text-[#131313] dark:text-white">
          System of Equations Solver
        </h1>
        <p class="hidden sm:block text-xs sm:text-sm text-[#616161] dark:text-[#A19891] max-w-3xl">
          Solve 2×2 and 3×3 simultaneous equations step-by-step using substitution, elimination, and Cramer's determinant rule.
        </p>
      </header>

      <section class="w-full">
        <EquationSolver client:load initialMode="system" hideHeader wideLayout />
      </section>

      <section class="bg-white dark:bg-[#1B1B1B] p-4 sm:p-6 rounded-2xl border border-[#E0E0E0] dark:border-[#2E2825] shadow-xs space-y-3">
        <h2 class="text-base sm:text-lg font-bold text-[#131313] dark:text-white">Methods for Solving Systems</h2>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] leading-relaxed">
          A system of linear equations consists of two or more equations with shared variables. The solution is the point (x, y) where all lines intersect.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-center sm:text-left text-[#131313] dark:text-white">Frequently Asked Questions</h2>
        <div class="space-y-3">
          <div class="bg-white dark:bg-[#3E2723] p-4 rounded-lg border border-[#E0E0E0] dark:border-[#5D4037]">
            <h3 class="font-semibold text-lg">How does the system of equations solver work?</h3>
            <p class="mt-2 opacity-90">Enter your equations separated by commas (e.g. 2x + y = 7, x - y = 2). The solver sets up the matrix form Ax = b and computes the determinant using Cramer's Rule or Gaussian elimination to find the exact intersection point.</p>
          </div>
          <div class="bg-white dark:bg-[#3E2723] p-4 rounded-lg border border-[#E0E0E0] dark:border-[#5D4037]">
            <h3 class="font-semibold text-lg">Can it solve 3-variable systems?</h3>
            <p class="mt-2 opacity-90">Yes, it supports systems with x, y, and z variables using row reduction and back-substitution.</p>
          </div>
          <div class="bg-white dark:bg-[#3E2723] p-4 rounded-lg border border-[#E0E0E0] dark:border-[#5D4037]">
            <h3 class="font-semibold text-lg">What happens if a system has no solution?</h3>
            <p class="mt-2 opacity-90">When the determinant is zero, the solver identifies whether the lines are parallel (inconsistent / no solution) or coincident (infinitely many solutions).</p>
          </div>
        </div>
      </section>

      <footer class="text-center space-y-4 pt-8 border-t border-[#E0E0E0] dark:border-[#5D4037]">
        <h3 class="text-xl font-medium">Explore Other Solvers</h3>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/matrix-solver" class="text-blue-600 dark:text-blue-400 hover:underline">Matrix Solver</a>
          <a href="/quadratic-equation-solver" class="text-blue-600 dark:text-blue-400 hover:underline">Quadratic Equation Solver</a>
          <a href="/equation-solver-with-steps" class="text-blue-600 dark:text-blue-400 hover:underline">Equation Solver with Steps</a>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>
