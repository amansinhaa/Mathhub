---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GraphModuleClient from '@/components/shared/GraphModuleClient';
import AdBanner from '@/components/ads/AdBanner.astro';

const title = 'How to Find Limits in Calculus — Step-by-Step Guide';
const description = 'Learn how to evaluate limits in calculus with direct substitution, factoring, rationalizing, and L\'Hôpital\'s Rule. Worked examples and interactive graphing.';
const canonical = 'https://www.easyequate.com/learn/how-to-find-limits';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a limit in calculus?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A limit is the value that a function approaches as the input (x) gets closer and closer to a particular number, regardless of whether the function is actually defined at that exact point."
      }
    },
    {
      "@type": "Question",
      "name": "What does an indeterminate form 0/0 mean?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An indeterminate form like 0/0 does not mean undefined or zero. It means direct substitution failed and further algebraic work (such as factoring, canceling, rationalizing, or L'Hôpital's Rule) is needed to reveal the true limit value."
      }
    },
    {
      "@type": "Question",
      "name": "When does a limit fail to exist (DNE)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A two-sided limit does not exist (DNE) if: 1) the left-hand limit and right-hand limit approach different values, 2) the function oscillates infinitely, or 3) the function approaches infinity from one or both sides."
      }
    },
    {
      "@type": "Question",
      "name": "What is L'Hôpital's Rule?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "L'Hôpital's Rule states that if evaluating a limit lim(x→a) [f(x)/g(x)] produces 0/0 or ±∞/±∞, you can differentiate the numerator and denominator independently: lim [f'(x)/g'(x)]."
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={faqSchema}>
  <article class="max-w-4xl mx-auto px-4 py-8 prose prose-brown dark:prose-invert pt-10 sm:pt-8 sm:pl-36 md:pl-44">
    <div class="mb-6">
      <a href="/learn" class="text-sm font-medium text-[#5D4037] dark:text-[#D7CCC8] hover:underline">&larr; Back to Guides</a>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold text-[#5D4037] dark:text-[#EFEBE9] mb-4">How to Find Limits in Calculus</h1>
    <p class="lead text-lg text-[#131313] dark:text-[#E0E0E0] mb-8">
      Evaluating limits is the starting point of calculus. When plugging in a number gives you 0/0, these four methods will help you solve almost any limit problem.
    </p>

    <h2 class="text-2xl font-bold text-[#5D4037] dark:text-[#EFEBE9] mt-8 mb-4">1. Direct Substitution (Try This First)</h2>
    <p>
      The simplest technique is to plug the target number directly into <code>x</code>. If the function is continuous at that point, the result is your answer.
    </p>
    <div class="bg-[#EFEBE9] dark:bg-[#3E2723] p-4 rounded-lg my-4 font-mono text-sm sm:text-base">
      lim (x &rarr; 3) [x² + 2x - 1] = (3)² + 2(3) - 1 = 9 + 6 - 1 = 14
    </div>

    <h2 class="text-2xl font-bold text-[#5D4037] dark:text-[#EFEBE9] mt-8 mb-4">2. Factoring and Canceling (For 0/0 Forms)</h2>
    <p>
      If direct substitution yields <code>0/0</code>, you have an <strong>indeterminate form</strong>. There is usually a removable "hole" in the graph caused by a common factor.
    </p>
    <p><strong>Example:</strong> Evaluate <code>lim (x &rarr; 2) (x² - 4) / (x - 2)</code>.</p>
    <ol>
      <li>Plugging in <code>x = 2</code> gives <code>(4 - 4)/(2 - 2) = 0/0</code>.</li>
      <li>Factor the numerator: <code>x² - 4 = (x - 2)(x + 2)</code>.</li>
      <li>Cancel the common <code>(x - 2)</code> factor: <code>lim (x &rarr; 2) (x + 2)</code>.</li>
      <li>Now substitute <code>x = 2</code>: <code>2 + 2 = 4</code>.</li>
    </ol>

    <h2 class="text-2xl font-bold text-[#5D4037] dark:text-[#EFEBE9] mt-8 mb-4">3. Multiplying by the Conjugate (For Square Roots)</h2>
    <p>
      When an expression has radical terms (square roots) producing <code>0/0</code>, multiply both the numerator and denominator by the <strong>conjugate</strong> (change the sign between the terms).
    </p>
    <p>
      For example, if you have <code>(&radic;(x + 1) - 1) / x</code> as <code>x &rarr; 0</code>, multiply by <code>(&radic;(x + 1) + 1)</code>. The square roots eliminate, leaving an algebraic factor that cancels cleanly.
    </p>

    <h2 class="text-2xl font-bold text-[#5D4037] dark:text-[#EFEBE9] mt-8 mb-4">4. L'Hôpital's Rule</h2>
    <p>
      For stubborn fractions producing <code>0/0</code> or <code>&infin;/&infin;</code>, differentiate the top and bottom separately:
    </p>
    <div class="bg-[#EFEBE9] dark:bg-[#3E2723] p-4 rounded-lg my-4 text-center font-mono text-base">
      lim [f(x) / g(x)] = lim [f'(x) / g'(x)]
    </div>

    <div class="not-prose my-8 p-6 bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] rounded-2xl shadow-sm">
      <h3 class="text-xl font-bold text-[#5D4037] dark:text-[#EFEBE9] mb-2">Try it Live: Visualizing a Removable Discontinuity</h3>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
        Try plotting <code>f(x) = (x^2 - 4)/(x - 2)</code> below. The line looks solid at <code>y = x + 2</code>, but if you look at <code>x = 2</code>, the true limit approaches exactly <code>y = 4</code>!
      </p>
      <div class="h-[500px] border border-[#E0E0E0] dark:border-[#2E2825] rounded-xl overflow-hidden">
        <GraphModuleClient client:only="react" />
      </div>
    </div>

    <AdBanner />

    <h2 class="text-2xl font-bold text-[#5D4037] dark:text-[#EFEBE9] mt-12 mb-6">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {faqSchema.mainEntity.map((item) => (
        <div class="border border-[#E0E0E0] dark:border-[#2E2825] rounded-lg p-4 bg-white dark:bg-[#1B1B1B]">
          <h3 class="font-bold text-[#5D4037] dark:text-[#EFEBE9] mb-2 text-base">{item.name}</h3>
          <p class="text-sm text-[#131313] dark:text-[#E0E0E0] m-0">{item.acceptedAnswer.text}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 pt-6 border-t border-[#E0E0E0] dark:border-[#2E2825]">
      <h3 class="text-lg font-bold text-[#5D4037] dark:text-[#EFEBE9] mb-4">Continue Your Calculus Learning:</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose">
        <a href="/learn/what-is-a-derivative" class="p-4 border border-[#E0E0E0] dark:border-[#2E2825] rounded-xl hover:shadow-md transition-shadow bg-white dark:bg-[#1B1B1B]">
          <span class="text-xs text-[#5D4037] dark:text-[#D7CCC8] font-bold block mb-1">CALCULUS PART 2 &rarr;</span>
          <span class="font-bold text-[#131313] dark:text-white">What is a Derivative?</span>
        </a>
        <a href="/derivative-calculator" class="p-4 border border-[#E0E0E0] dark:border-[#2E2825] rounded-xl hover:shadow-md transition-shadow bg-white dark:bg-[#1B1B1B]">
          <span class="text-xs text-[#5D4037] dark:text-[#D7CCC8] font-bold block mb-1">CALCULUS SOLVER &rarr;</span>
          <span class="font-bold text-[#131313] dark:text-white">Derivative Calculator with Steps</span>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
