---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GraphModuleClient from '@/components/shared/GraphModuleClient';
import AdBanner from '@/components/ads/AdBanner.astro';

const title = 'How to Solve Simultaneous Equations (3 Easy Methods)';
const description = 'Learn how to solve simultaneous equations step by step using elimination, substitution, and graphical methods with worked examples and live graphing.';
const canonical = 'https://www.easyequate.com/learn/how-to-solve-simultaneous-equations';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are simultaneous equations?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Simultaneous equations (also called a system of equations) are two or more algebraic equations containing multiple unknowns that are true at the same time. The solution is the set of values that satisfies all equations simultaneously."
      }
    },
    {
      "@type": "Question",
      "name": "When should I use substitution instead of elimination?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Substitution is easiest when one variable already has a coefficient of 1 or -1 (like y = 2x + 3). Elimination is preferred when both equations have coefficients greater than 1 aligned in columns (like 3x + 2y = 12 and 5x - 2y = 4)."
      }
    },
    {
      "@type": "Question",
      "name": "What does it mean if simultaneous equations have no solution?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If two linear equations have no solution, their graphs are parallel lines with identical slopes but different y-intercepts. Because parallel lines never intersect, there is no coordinate point (x, y) that satisfies both."
      }
    },
    {
      "@type": "Question",
      "name": "Can simultaneous equations have infinite solutions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. If one equation is a multiple of the other (e.g., 2x + y = 4 and 4x + 2y = 8), they represent the exact same line. Every point on that line is a valid solution."
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={faqSchema}>
  <article class="max-w-4xl mx-auto px-4 py-8 prose prose-brown dark:prose-invert pt-10 sm:pt-8 sm:pl-36 md:pl-44">
    <div class="mb-6">
      <a href="/learn" class="text-sm font-medium text-[#5D4037] dark:text-[#D7CCC8] hover:underline">&larr; Back to Guides</a>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold text-[#5D4037] dark:text-[#EFEBE9] mb-4">How to Solve Simultaneous Equations</h1>
    <p class="lead text-lg text-[#131313] dark:text-[#E0E0E0] mb-8">
      Master the three proven techniques to solve systems of linear equations: Elimination, Substitution, and Graphical analysis.
    </p>

    <h2 class="text-2xl font-bold text-[#5D4037] dark:text-[#EFEBE9] mt-8 mb-4">Method 1: The Elimination Method</h2>
    <p>
      The <strong>elimination method</strong> works by adding or subtracting the equations to cancel out one of the variables entirely.
    </p>
    <p><strong>Example Problem:</strong></p>
    <div class="bg-[#EFEBE9] dark:bg-[#3E2723] p-4 rounded-lg my-4 font-mono text-sm sm:text-base">
      Equation (1): 2x + 3y = 19<br />
      Equation (2): 2x - y = 7
    </div>
    <ol>
      <li><strong>Subtract Equation (2) from Equation (1):</strong><br />
        <code>(2x - 2x) + (3y - (-y)) = 19 - 7</code><br />
        <code>4y = 12 &rarr; y = 3</code>
      </li>
      <li><strong>Substitute y = 3 back into Equation (2):</strong><br />
        <code>2x - 3 = 7 &rarr; 2x = 10 &rarr; x = 5</code>
      </li>
      <li><strong>Final Solution:</strong> <code>(x = 5, y = 3)</code>.</li>
    </ol>

    <h2 class="text-2xl font-bold text-[#5D4037] dark:text-[#EFEBE9] mt-8 mb-4">Method 2: The Substitution Method</h2>
    <p>
      The <strong>substitution method</strong> works by isolating one variable in terms of the other, then substituting that expression into the second equation.
    </p>
    <p><strong>Example Problem:</strong></p>
    <div class="bg-[#EFEBE9] dark:bg-[#3E2723] p-4 rounded-lg my-4 font-mono text-sm sm:text-base">
      Equation (1): y = 2x - 1<br />
      Equation (2): 3x + 2y = 12
    </div>
    <ol>
      <li><strong>Substitute (2x - 1) into Equation (2) in place of y:</strong><br />
        <code>3x + 2(2x - 1) = 12</code>
      </li>
      <li><strong>Expand and combine like terms:</strong><br />
        <code>3x + 4x - 2 = 12 &rarr; 7x = 14 &rarr; x = 2</code>
      </li>
      <li><strong>Calculate y:</strong><br />
        <code>y = 2(2) - 1 = 4 - 1 = 3</code>
      </li>
      <li><strong>Final Solution:</strong> <code>(x = 2, y = 3)</code>.</li>
    </ol>

    <h2 class="text-2xl font-bold text-[#5D4037] dark:text-[#EFEBE9] mt-8 mb-4">Method 3: The Graphical Method</h2>
    <p>
      Every linear equation corresponds to a straight line on a graph. The point <code>(x, y)</code> where the two lines cross is the simultaneous solution.
    </p>

    <div class="not-prose my-8 p-6 bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] rounded-2xl shadow-sm">
      <h3 class="text-xl font-bold text-[#5D4037] dark:text-[#EFEBE9] mb-2">Try it Live: Find the Intersection Point</h3>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
        In the interactive plotter below, enter <code>y = 2x - 1</code> as line 1, and <code>y = (12 - 3x)/2</code> as line 2. Inspect where the lines intersect—they cross precisely at <code>(2, 3)</code>!
      </p>
      <div class="h-[500px] border border-[#E0E0E0] dark:border-[#2E2825] rounded-xl overflow-hidden">
        <GraphModuleClient client:only="react" />
      </div>
    </div>

    <AdBanner />

    <h2 class="text-2xl font-bold text-[#5D4037] dark:text-[#EFEBE9] mt-12 mb-6">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {faqSchema.mainEntity.map((item) => (
        <div class="border border-[#E0E0E0] dark:border-[#2E2825] rounded-lg p-4 bg-white dark:bg-[#1B1B1B]">
          <h3 class="font-bold text-[#5D4037] dark:text-[#EFEBE9] mb-2 text-base">{item.name}</h3>
          <p class="text-sm text-[#131313] dark:text-[#E0E0E0] m-0">{item.acceptedAnswer.text}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 pt-6 border-t border-[#E0E0E0] dark:border-[#2E2825]">
      <h3 class="text-lg font-bold text-[#5D4037] dark:text-[#EFEBE9] mb-4">Solve Instantly with EasyEquate Tools:</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose">
        <a href="/system-of-equations" class="p-4 border border-[#E0E0E0] dark:border-[#2E2825] rounded-xl hover:shadow-md transition-shadow bg-white dark:bg-[#1B1B1B]">
          <span class="text-xs text-[#5D4037] dark:text-[#D7CCC8] font-bold block mb-1">AUTOMATED SOLVER &rarr;</span>
          <span class="font-bold text-[#131313] dark:text-white">System of Equations Solver</span>
        </a>
        <a href="/matrix-solver" class="p-4 border border-[#E0E0E0] dark:border-[#2E2825] rounded-xl hover:shadow-md transition-shadow bg-white dark:bg-[#1B1B1B]">
          <span class="text-xs text-[#5D4037] dark:text-[#D7CCC8] font-bold block mb-1">ADVANCED ALGEBRA &rarr;</span>
          <span class="font-bold text-[#131313] dark:text-white">Matrix & RREF Solver</span>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
