---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GcdLcmCalculator from '@/components/calculator/GcdLcmCalculator';
import AdBanner from '@/components/ads/AdBanner.astro';

const title = 'GCD & LCM Calculator — Greatest Common Divisor Solver';
const description = 'Free GCD and LCM calculator with steps. Find the Greatest Common Divisor (HCF) and Least Common Multiple of 2 or 3 numbers using Euclidean algorithm.';
const canonical = 'https://www.easyequate.com/gcd-lcm-calculator';

const faqs = [
  {
    q: "What is the Greatest Common Divisor (GCD or HCF)?",
    a: "The GCD (also known as the Highest Common Factor or HCF) is the largest positive integer that divides two or more given numbers without leaving a remainder. For example, GCD(48, 180) = 12."
  },
  {
    q: "What is the Least Common Multiple (LCM)?",
    a: "The LCM is the smallest positive integer that is divisible by all given numbers. For example, LCM(48, 180) = 720."
  },
  {
    q: "How does the Euclidean algorithm find the GCD?",
    a: "The Euclidean algorithm divides the larger number by the smaller number and takes the remainder. It repeats by dividing the previous divisor by the remainder until the remainder is 0. The final non-zero divisor is the GCD."
  },
  {
    q: "What is the relationship between GCD and LCM?",
    a: "For any two positive integers a and b, their product equals the product of their GCD and LCM: a × b = GCD(a, b) × LCM(a, b). This means LCM(a, b) = (a × b) ÷ GCD(a, b)."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "EasyEquate GCD & LCM Calculator",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <div class="w-full text-[#131313] dark:text-[#F5F5F5] py-1">
    <div class="max-w-6xl xl:max-w-7xl mx-auto space-y-4 sm:space-y-6">
      <header class="space-y-1 sm:space-y-1.5 text-center sm:text-left pt-10 sm:pt-0 sm:pl-36 md:pl-44">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-[#EFEBE9] dark:bg-[#25201E] border border-[#D7CCC8] dark:border-[#3E2723] text-[10px] sm:text-xs font-mono font-bold text-[#5D4037] dark:text-[#D7CCC8]">
          <span>NUMBER THEORY</span>
          <span>•</span>
          <span>EUCLIDEAN & PRIME FACTORIZATION</span>
        </div>
        <h1 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-[#131313] dark:text-white">
          GCD & LCM Calculator
        </h1>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] max-w-3xl">
          Find the Greatest Common Divisor (GCD / HCF) and Least Common Multiple (LCM) with complete step-by-step division and prime factor breakdowns.
        </p>
      </header>

      <section class="w-full">
        <GcdLcmCalculator client:load />
      </section>

      <AdBanner />

      <section class="bg-white dark:bg-[#1B1B1B] p-4 sm:p-6 rounded-2xl border border-[#E0E0E0] dark:border-[#2E2825] shadow-xs space-y-3">
        <h2 class="text-base sm:text-lg font-bold text-[#131313] dark:text-white">Euclidean Algorithm vs Prime Factorization</h2>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] leading-relaxed">
          While prime factorization breaks each number down into its constituent prime building blocks, it can become computationally slow for very large numbers. In contrast, the Euclidean algorithm, documented by the ancient Greek mathematician Euclid around 300 BC, relies on repeated division and finds the GCD rapidly even for numbers with hundreds of digits.
        </p>
      </section>

      <section class="space-y-3 sm:space-y-4">
        <h2 class="text-base sm:text-xl font-bold text-[#131313] dark:text-white">Frequently Asked Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {faqs.map(faq => (
            <div class="p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] space-y-1.5">
              <h3 class="text-xs sm:text-sm font-bold text-[#131313] dark:text-white">{faq.q}</h3>
              <p class="text-xs text-[#616161] dark:text-[#A19891] leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <footer class="text-center space-y-4 pt-8 border-t border-[#E0E0E0] dark:border-[#5D4037]">
        <h3 class="text-xl font-medium">Explore Related Solvers</h3>
        <div class="flex flex-wrap justify-center gap-4 text-sm">
          <a href="/fraction-calculator" class="text-blue-600 dark:text-blue-400 hover:underline">Fraction Calculator</a>
          <a href="/percentage-calculator" class="text-blue-600 dark:text-blue-400 hover:underline">Percentage Calculator</a>
          <a href="/equation-solver-with-steps" class="text-blue-600 dark:text-blue-400 hover:underline">Equation Solver</a>
          <a href="/calculator" class="text-blue-600 dark:text-blue-400 hover:underline">Scientific Calculator</a>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>
