---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MatrixSolverWidget from '@/components/solver/MatrixSolverWidget';

const title = 'Matrix Solver — Determinant, Inverse & RREF | EasyEquate';
const description = 'Free step-by-step matrix solver. Calculate determinant, inverse, multiply matrices, RREF, and find eigenvalues with full working shown.';
const canonical = 'https://www.easyequate.com/matrix-solver';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "EasyEquate Matrix Solver",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do you find the determinant of a matrix?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a 2x2 matrix, the determinant is ad - bc. For a 3x3, you use cofactor expansion along a row or column. Our solver shows the exact steps for both."
          }
        },
        {
          "@type": "Question",
          "name": "What is an inverse matrix?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An inverse matrix is a matrix that, when multiplied by the original matrix, yields the identity matrix. A matrix must be square and have a non-zero determinant to be invertible."
          }
        },
        {
          "@type": "Question",
          "name": "How does matrix multiplication work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To multiply matrices, you multiply the elements of each row of the first matrix by the corresponding elements of each column of the second matrix, then add the products."
          }
        },
        {
          "@type": "Question",
          "name": "What is Row Reduced Echelon Form (RREF)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "RREF is a simplified matrix form achieved through Gaussian elimination, where leading entries are 1 and all other entries in the leading column are 0."
          }
        },
        {
          "@type": "Question",
          "name": "Can it solve eigenvalues?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, our matrix calculator computes the characteristic polynomial det(A - λI) = 0 and finds real and complex eigenvalues."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <div class="w-full text-[#5D4037] dark:text-[#EFEBE9] py-1">
    <div class="max-w-6xl xl:max-w-7xl mx-auto space-y-3 sm:space-y-5">
      <header class="space-y-1 sm:space-y-1.5 text-center sm:text-left pt-10 sm:pt-0 sm:pl-36 md:pl-44">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-[#EFEBE9] dark:bg-[#25201E] border border-[#D7CCC8] dark:border-[#3E2723] text-[10px] sm:text-xs font-mono font-bold text-[#5D4037] dark:text-[#D7CCC8]">
          <span>LINEAR ALGEBRA</span>
          <span>•</span>
          <span>STEP-BY-STEP WORKINGS</span>
        </div>
        <h1 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-[#131313] dark:text-white">
          Matrix Solver — Step-by-Step
        </h1>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] max-w-3xl">
          Calculate determinants, matrix inverses, products, row reduced echelon form (RREF), and eigenvalues with full intermediate steps.
        </p>
      </header>

      <section class="w-full">
        <MatrixSolverWidget client:load />
      </section>

      <section class="bg-white dark:bg-[#1B1B1B] p-4 sm:p-6 rounded-2xl border border-[#E0E0E0] dark:border-[#2E2825] shadow-xs space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-[#131313] dark:text-white">Master Matrix Operations</h2>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] leading-relaxed">
          Matrices are the foundation of linear algebra, 3D graphics, machine learning, and quantum mechanics. Our solver shows the exact row operations, cross-products, and cofactor expansions so you can learn how each formula works.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-center sm:text-left text-[#131313] dark:text-white">Frequently Asked Questions</h2>
        <div class="space-y-3">
          <div class="bg-white dark:bg-[#3E2723] p-4 rounded-lg border border-[#E0E0E0] dark:border-[#5D4037]">
            <h3 class="font-semibold text-lg">How do you find the determinant of a matrix?</h3>
            <p class="mt-2 opacity-90">For a 2x2 matrix, the determinant is ad - bc. For a 3x3, you use cofactor expansion along a row or column. Our solver shows the exact steps for both.</p>
          </div>
          <div class="bg-white dark:bg-[#3E2723] p-4 rounded-lg border border-[#E0E0E0] dark:border-[#5D4037]">
            <h3 class="font-semibold text-lg">What is an inverse matrix?</h3>
            <p class="mt-2 opacity-90">An inverse matrix is a matrix that, when multiplied by the original matrix, yields the identity matrix. A matrix must be square and have a non-zero determinant to be invertible.</p>
          </div>
          <div class="bg-white dark:bg-[#3E2723] p-4 rounded-lg border border-[#E0E0E0] dark:border-[#5D4037]">
            <h3 class="font-semibold text-lg">How does matrix multiplication work?</h3>
            <p class="mt-2 opacity-90">To multiply matrices, you multiply the elements of each row of the first matrix by the corresponding elements of each column of the second matrix, then add the products.</p>
          </div>
          <div class="bg-white dark:bg-[#3E2723] p-4 rounded-lg border border-[#E0E0E0] dark:border-[#5D4037]">
            <h3 class="font-semibold text-lg">What is Row Reduced Echelon Form (RREF)?</h3>
            <p class="mt-2 opacity-90">RREF is a simplified matrix form achieved through Gaussian elimination, where leading entries are 1 and all other entries in the leading column are 0.</p>
          </div>
          <div class="bg-white dark:bg-[#3E2723] p-4 rounded-lg border border-[#E0E0E0] dark:border-[#5D4037]">
            <h3 class="font-semibold text-lg">Can it solve eigenvalues?</h3>
            <p class="mt-2 opacity-90">Yes, our matrix calculator computes the characteristic polynomial det(A - λI) = 0 and finds real and complex eigenvalues.</p>
          </div>
        </div>
      </section>

      <footer class="text-center space-y-4 pt-8 border-t border-[#E0E0E0] dark:border-[#5D4037]">
        <h3 class="text-xl font-medium">Explore Other Solvers</h3>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/quadratic-equation-solver" class="text-blue-600 dark:text-blue-400 hover:underline">Quadratic Equation Solver</a>
          <a href="/equation-solver-with-steps" class="text-blue-600 dark:text-blue-400 hover:underline">Equation Solver with Steps</a>
          <a href="/system-of-equations" class="text-blue-600 dark:text-blue-400 hover:underline">System of Equations</a>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>
