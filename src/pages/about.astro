---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Sparkles, Cpu, ShieldCheck, Heart, ArrowLeft, BookOpen, Compass, Calculator } from 'lucide-react';

const title = 'About EasyEquate — Free Step-by-Step Math Tools';
const description = 'Why EasyEquate was built: fast, free, in-browser math calculators and step-by-step solvers without paywalls, accounts, or intrusive popups.';
const canonical = 'https://www.easyequate.com/about';
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="max-w-4xl mx-auto py-6 sm:py-10 px-4 space-y-8 animate-fade-in pt-10 sm:pt-6 sm:pl-36 md:pl-44">
    <!-- Header Breadcrumb -->
    <div class="flex items-center gap-2 text-xs font-mono text-[#757575] dark:text-[#A19891]">
      <a
        href="/"
        class="hover:text-[#5D4037] dark:hover:text-white flex items-center gap-1 transition-colors"
      >
        <ArrowLeft size={14} /> Back to EasyEquate
      </a>
      <span>/</span>
      <span class="text-[#5D4037] dark:text-[#D7CCC8] font-bold">About</span>
    </div>

    <!-- Title Header -->
    <div class="space-y-3 border-b border-[#E0E0E0] dark:border-[#2E2825] pb-5">
      <div class="flex items-center gap-2.5">
        <div class="p-2 rounded-xl bg-[#EFEBE9] dark:bg-[#3E2723] text-[#5D4037] dark:text-[#D7CCC8]">
          <Sparkles size={24} />
        </div>
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#131313] dark:text-white">
            About EasyEquate
          </h1>
          <p class="text-xs sm:text-sm text-[#757575] dark:text-[#A19891] mt-0.5">
            Free, in-browser math tools that show every step without paywalls or accounts.
          </p>
        </div>
      </div>
    </div>

    <!-- Story & Motivation -->
    <div class="prose prose-neutral dark:prose-invert max-w-none text-sm leading-relaxed space-y-6 text-[#424242] dark:text-[#D7CCC8]">
      <section class="space-y-3">
        <h2 class="text-lg font-bold text-[#131313] dark:text-white">
          Why I Built This
        </h2>
        <p>
          If you've ever tried looking up a math solution online late at night while doing homework, you've probably run into the same frustration:
          popular solver websites show you the final answer, but blur out all the intermediate steps unless you pay $10/month. Other sites bombard you with popups, force you to create an account, or take forever to load.
        </p>
        <p>
          I built <strong>EasyEquate</strong> as a cleaner alternative. It gives students, teachers, and anyone brushing up on math a straightforward place to solve equations, plot graphs, and actually see how the solution was found—completely free, with zero sign-up required.
        </p>
      </section>

      <!-- Three Pillars -->
      <section class="grid grid-cols-1 sm:grid-cols-3 gap-4 py-2 not-prose">
        <div class="p-4 rounded-2xl bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] space-y-2 shadow-2xs">
          <div class="w-8 h-8 rounded-lg bg-[#EFEBE9] dark:bg-[#3E2723] text-[#5D4037] dark:text-[#D7CCC8] flex items-center justify-center font-bold">
            <Cpu size={18} />
          </div>
          <h3 class="font-bold text-sm text-[#131313] dark:text-white">Runs in Your Browser</h3>
          <p class="text-xs text-[#616161] dark:text-[#A19891] leading-relaxed">
            Calculations and graphs are evaluated directly on your device using JavaScript. There's no server lag or queue.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] space-y-2 shadow-2xs">
          <div class="w-8 h-8 rounded-lg bg-[#EFEBE9] dark:bg-[#3E2723] text-[#5D4037] dark:text-[#D7CCC8] flex items-center justify-center font-bold">
            <ShieldCheck size={18} />
          </div>
          <h3 class="font-bold text-sm text-[#131313] dark:text-white">No Accounts or Logins</h3>
          <p class="text-xs text-[#616161] dark:text-[#A19891] leading-relaxed">
            No signup, no passwords, no email collection. Just bookmark the page and use it whenever you need it.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] space-y-2 shadow-2xs">
          <div class="w-8 h-8 rounded-lg bg-[#EFEBE9] dark:bg-[#3E2723] text-[#5D4037] dark:text-[#D7CCC8] flex items-center justify-center font-bold">
            <Heart size={18} />
          </div>
          <h3 class="font-bold text-sm text-[#131313] dark:text-white">Every Step Included</h3>
          <p class="text-xs text-[#616161] dark:text-[#A19891] leading-relaxed">
            From polynomial synthetic division to calculus chain rules, step-by-step workings are open to everyone.
          </p>
        </div>
      </section>

      <!-- What's on EasyEquate -->
      <section class="space-y-3">
        <h2 class="text-lg font-bold text-[#131313] dark:text-white">
          What You Can Do on EasyEquate
        </h2>
        <div class="space-y-3 not-prose">
          <div class="flex items-start gap-3 p-3.5 rounded-xl bg-[#F5F5F5] dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825]">
            <Calculator className="text-[#5D4037] dark:text-[#D7CCC8] shrink-0 mt-0.5" size={18} />
            <div>
              <h4 class="text-xs font-bold text-[#131313] dark:text-white">Calculators & Conversions</h4>
              <p class="text-xs text-[#616161] dark:text-[#A19891] leading-relaxed">
                Scientific calculator with calculation history, percentages, fractions, GCD/LCM, unit conversions, and full matrix operations (determinant, inverse, RREF).
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3 p-3.5 rounded-xl bg-[#F5F5F5] dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825]">
            <Compass className="text-[#5D4037] dark:text-[#D7CCC8] shrink-0 mt-0.5" size={18} />
            <div>
              <h4 class="text-xs font-bold text-[#131313] dark:text-white">Step-by-Step Algebra & Calculus Solvers</h4>
              <p class="text-xs text-[#616161] dark:text-[#A19891] leading-relaxed">
                Quadratic equations, polynomials, systems of equations, derivatives, and integrals with detailed intermediate working.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3 p-3.5 rounded-xl bg-[#F5F5F5] dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825]">
            <BookOpen className="text-[#5D4037] dark:text-[#D7CCC8] shrink-0 mt-0.5" size={18} />
            <div>
              <h4 class="text-xs font-bold text-[#131313] dark:text-white">2D Graphing & Exam Formula Sheets</h4>
              <p class="text-xs text-[#616161] dark:text-[#A19891] leading-relaxed">
                Interactive function plotter with turning points and roots, plus quick-reference formula sheets for GCSE, A-Level, Edexcel, and CBSE boards.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Technical Approach -->
      <section class="space-y-3">
        <h2 class="text-lg font-bold text-[#131313] dark:text-white">
          How It's Built
        </h2>
        <p>
          EasyEquate is built with Astro, React, and Tailwind CSS. Symbolic math is powered by open-source libraries like Math.js and Nerdamer, paired with custom step-generation logic to make algebraic steps look the way they are taught in school and college classrooms.
        </p>
      </section>

      <!-- Creator / Organization Info -->
      <section class="space-y-3 pt-4 border-t border-[#E0E0E0] dark:border-[#2E2825]">
        <h2 class="text-lg font-bold text-[#131313] dark:text-white">
          Creator & Contact
        </h2>
        <div class="p-4 rounded-xl bg-white dark:bg-[#181818] border border-[#E0E0E0] dark:border-[#2E2825] text-xs space-y-1">
          <div><span class="font-bold text-[#131313] dark:text-white">Creator:</span> Aman Kumar</div>
          <div><span class="font-bold text-[#131313] dark:text-white">Location:</span> India</div>
          <div><span class="font-bold text-[#131313] dark:text-white">Email:</span> <a href="mailto:kumaraman6376@gmail.com" class="text-[#5D4037] dark:text-[#D7CCC8] underline">kumaraman6376@gmail.com</a></div>
          <div class="text-[#757575] dark:text-[#A19891] pt-1">If you spot a bug or want to suggest a new calculator feature, feel free to reach out.</div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
