---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EquationSolver from '@/components/solver/EquationSolver';
import AdBanner from '@/components/ads/AdBanner.astro';

const title = 'Equation Solver with Steps — Algebra Solver | EasyEquate';
const description = 'Free step-by-step equation solver. Shows every working step for linear, quadratic, cubic equations, systems, and inequalities. No sign-up required.';
const canonical = 'https://www.easyequate.com/equation-solver-with-steps';

const faqs = [
  {
    q: "How does the step-by-step solver work?",
    a: "The solver parses your equation and applies algebraic rules sequentially, showing each transformation like adding/subtracting from both sides or factoring, until the variable is isolated."
  },
  {
    q: "Can it solve linear equations?",
    a: "Yes, it can solve linear equations with one or multiple variables by simplifying and isolating the target variable."
  },
  {
    q: "Does it handle systems of equations?",
    a: "Yes, it can solve systems of equations using substitution, elimination, or matrix methods, providing steps for each."
  },
  {
    q: "What about polynomials?",
    a: "It can solve quadratic, cubic, and higher-order polynomials using factoring, formulas, or numerical approximation where necessary."
  },
  {
    q: "Do I have to pay to see the steps?",
    a: "No, EasyEquate provides all step-by-step solutions completely free."
  },
  {
    q: "How do you solve an equation with variables on both sides step by step?",
    a: "First, simplify each side by expanding parentheses and combining like terms. Next, collect all variable terms on one side by adding or subtracting from both sides. Finally, isolate the variable by moving constant terms to the opposite side and dividing by the coefficient."
  },
  {
    q: "What is an extraneous solution and why do they appear?",
    a: "An extraneous solution is a mathematical result derived during solving that does not satisfy the original equation. They most commonly occur when squaring both sides of a radical equation (which can introduce false positive signs) or when multiplying by variable denominators in rational equations (which can cause division by zero). Always substitute answers back into the original equation to verify validity."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "EasyEquate Equation Solver with Steps",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <div class="w-full text-[#5D4037] dark:text-[#EFEBE9] py-1">
    <div class="max-w-6xl xl:max-w-7xl mx-auto space-y-3 sm:space-y-5">
      <header class="space-y-1 sm:space-y-1.5 text-center sm:text-left pt-10 sm:pt-0 sm:pl-36 md:pl-44">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-[#EFEBE9] dark:bg-[#25201E] border border-[#D7CCC8] dark:border-[#3E2723] text-[10px] sm:text-xs font-mono font-bold text-[#5D4037] dark:text-[#D7CCC8]">
          <span>ALGEBRAIC ENGINE</span>
          <span>•</span>
          <span>STEP-BY-STEP WORKINGS</span>
        </div>
        <h1 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-[#131313] dark:text-white">
          Equation Solver with Steps
        </h1>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] max-w-3xl">
          Solves linear equations, quadratics, polynomials, or systems line-by-line with complete algebraic proofs.
        </p>
      </header>

      <section class="w-full">
        <EquationSolver client:load hideHeader wideLayout />
      </section>

      <!-- Clean Empty Space: AdBanner below solver widget -->
      <AdBanner />

      <section class="bg-white dark:bg-[#1B1B1B] p-4 sm:p-6 rounded-2xl border border-[#E0E0E0] dark:border-[#2E2825] shadow-xs space-y-2">
        <h2 class="text-base sm:text-lg font-bold text-[#131313] dark:text-white">How This Step-by-Step Solver Works</h2>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] leading-relaxed">
          Stuck on a math problem? Our solver breaks down complex equations into understandable steps, applying algebraic rules sequentially until the variable is isolated. Follow along line by line to understand every transformation.
        </p>
      </section>

      <section class="space-y-3 sm:space-y-4">
        <h2 class="text-base sm:text-xl font-bold text-[#131313] dark:text-white">Frequently Asked Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {faqs.map(faq => (
            <div class="p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] space-y-1.5">
              <h3 class="text-xs sm:text-sm font-bold text-[#131313] dark:text-white">{faq.q}</h3>
              <p class="text-xs text-[#616161] dark:text-[#A19891] leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <footer class="text-center space-y-4 pt-8 border-t border-[#E0E0E0] dark:border-[#5D4037]">
        <h3 class="text-xl font-medium">Explore Other Solvers</h3>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/quadratic-equation-solver" class="text-blue-600 dark:text-blue-400 hover:underline">Quadratic Equation Solver</a>
          <a href="/system-of-equations" class="text-blue-600 dark:text-blue-400 hover:underline">System of Equations</a>
          <a href="/inequality-solver" class="text-blue-600 dark:text-blue-400 hover:underline">Inequality Solver</a>
          <a href="/matrix-solver" class="text-blue-600 dark:text-blue-400 hover:underline">Matrix Solver</a>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>
