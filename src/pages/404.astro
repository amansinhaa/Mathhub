---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Page Not Found | EasyEquate';
const description = 'The requested page could not be found. Return to EasyEquate calculator or homepage.';
---

<BaseLayout title={title} description={description}>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <h1 class="text-4xl font-bold font-mono text-[#5D4037] dark:text-[#D7CCC8] mb-2">404</h1>
    <p class="text-sm text-[#616161] dark:text-[#A19891] mb-4">Page Not Found</p>
    <a
      href="/calculator"
      class="px-4 py-2 bg-[#5D4037] hover:bg-[#6D4C41] text-white text-xs font-semibold rounded-xl transition-colors shadow-xs"
    >
      Return to Calculator
    </a>
  </div>
</BaseLayout>
