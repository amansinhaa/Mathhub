---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ALL_PROBLEMS, type SolvedProblem } from '@/data/problems';
import { solveDerivative, solveIntegral } from '@/lib/math/calculusSolver';
import { solvePolynomial } from '@/lib/math/solver';
import EquationSolver from '@/components/solver/EquationSolver';
import AdBanner from '@/components/ads/AdBanner.astro';
import { ArrowLeft, BookOpen, CheckCircle2, Sparkles, ArrowRight, HelpCircle, Sigma } from 'lucide-react';
import katex from 'katex';

export function getStaticPaths() {
  return ALL_PROBLEMS.map((prob) => ({
    params: {
      category: prob.category,
      slug: prob.slug,
    },
    props: {
      problem: prob,
    },
  }));
}

interface Props {
  problem: SolvedProblem;
}

const { problem } = Astro.props;

// Compute solution at build time for instant server-rendered HTML
let solutionResult: any = null;
if (problem.toolType === 'derivative') {
  solutionResult = solveDerivative(problem.inputExpression);
} else if (problem.toolType === 'integral') {
  solutionResult = solveIntegral(problem.inputExpression);
} else {
  solutionResult = solvePolynomial(problem.inputExpression);
}

// Safe KaTeX renderer helper
function renderLatex(tex: string, displayMode = false): string {
  try {
    return katex.renderToString(tex, {
      throwOnError: false,
      displayMode,
    });
  } catch {
    return tex;
  }
}

// Find related problem objects
const relatedProblems = problem.relatedSlugs
  .map((rSlug) => ALL_PROBLEMS.find((p) => p.slug === rSlug))
  .filter((p): p is SolvedProblem => p !== undefined);

const canonical = `https://www.easyequate.com/solve/${problem.category}/${problem.slug}`;

const eduQuestionType =
  problem.toolType === 'derivative'
    ? 'Derivative'
    : problem.toolType === 'integral'
    ? 'Integral'
    : problem.category === 'calculus'
    ? 'Calculus'
    : problem.category === 'algebra'
    ? 'Polynomial Equation'
    : 'Mathematics';

// JSON-LD structured data for Google (MathSolver + FAQPage + HowTo)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['MathSolver', 'LearningResource'],
      'name': problem.h1,
      'description': problem.metaDescription,
      'url': canonical,
      'inLanguage': 'en',
      'usageInfo': 'https://www.easyequate.com/privacy-policy',
      'potentialAction': [
        {
          '@type': 'SolveMathAction',
          'target': `${canonical}?q={math_expression_string}`,
          'mathExpression-input': 'required name=math_expression_string',
          'eduQuestionType': [eduQuestionType],
        },
      ],
    },
    {
      '@type': 'FAQPage',
      'mainEntity': problem.faqs.map((f) => ({
        '@type': 'Question',
        'name': f.q,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': f.a,
        },
      })),
    },
  ],
};

const initialMode =
  problem.toolType === 'derivative'
    ? 'derivative'
    : problem.toolType === 'integral'
    ? 'integral'
    : 'polynomial';
---

<BaseLayout
  title={problem.metaTitle}
  description={problem.metaDescription}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto py-6 sm:py-10 px-4 space-y-6 sm:space-y-8 animate-fade-in pt-10 sm:pt-6 sm:pl-36 md:pl-44">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-1.5 text-xs font-mono text-[#757575] dark:text-[#A19891] overflow-x-auto scrollbar-none">
      <a href="/" class="hover:text-[#5D4037] dark:hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href="/solve" class="hover:text-[#5D4037] dark:hover:text-white transition-colors">Solved Problems</a>
      <span>/</span>
      <span class="capitalize">{problem.category}</span>
      <span>/</span>
      <span class="text-[#5D4037] dark:text-[#D7CCC8] font-bold truncate">{problem.problemText}</span>
    </nav>

    <!-- Header & Problem Statement -->
    <header class="space-y-3 border-b border-[#E0E0E0] dark:border-[#2E2825] pb-5">
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full bg-[#EFEBE9] dark:bg-[#3E2723] border border-[#D7CCC8] dark:border-[#5D4037]/50 text-[#5D4037] dark:text-[#D7CCC8] text-[10px] sm:text-xs font-mono font-semibold uppercase tracking-wider">
          {problem.category === 'calculus' ? 'Calculus' : 'Algebra'} • Step-by-Step
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#131313] dark:text-white">
        {problem.h1}
      </h1>

      <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] leading-relaxed">
        {problem.metaDescription}
      </p>

      <!-- Problem Formula Banner -->
      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <div class="text-[11px] font-mono uppercase tracking-wider text-[#757575] dark:text-[#8D827A] font-semibold">
            Problem Statement
          </div>
          <div class="text-xl sm:text-2xl font-bold text-[#131313] dark:text-white overflow-x-auto py-1">
            <Fragment set:html={renderLatex(problem.problemLatex, true)} />
          </div>
        </div>

        {solutionResult?.finalAnswer && (
          <div class="p-3 sm:p-4 rounded-xl bg-[#F0FDF4] dark:bg-[#132A1C] border border-[#BBF7D0] dark:border-[#1E4D2B] text-center sm:text-right shrink-0">
            <div class="text-[10px] font-mono uppercase tracking-wider text-[#15803D] dark:text-[#4ADE80] font-bold flex items-center justify-center sm:justify-end gap-1">
              <CheckCircle2 size={12} /> Final Result
            </div>
            <div class="text-base sm:text-lg font-bold text-[#166534] dark:text-[#86EFAC] mt-0.5">
              <Fragment set:html={renderLatex(solutionResult.finalAnswer, false)} />
            </div>
          </div>
        )}
      </div>
    </header>

    <!-- Top Ad Placement -->
    <AdBanner />

    <!-- Required Formula Card -->
    <section class="p-4 sm:p-5 rounded-2xl bg-[#FDFBF7] dark:bg-[#1F1C1A] border border-[#E8E1D9] dark:border-[#3E2723] space-y-2.5 shadow-2xs">
      <div class="flex items-center gap-2 text-[#5D4037] dark:text-[#D7CCC8]">
        <Sigma size={18} />
        <h2 class="text-sm sm:text-base font-bold text-[#131313] dark:text-white">
          Formula Required: {problem.requiredFormula.name}
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] leading-relaxed">
        {problem.requiredFormula.explanation}
      </p>
      <div class="p-3 rounded-xl bg-white dark:bg-[#161413] border border-[#E0DCD6] dark:border-[#2E2825] overflow-x-auto text-center py-2.5">
        <Fragment set:html={renderLatex(problem.requiredFormula.latex, true)} />
      </div>
    </section>

    <!-- Step-by-Step Solution Breakdown -->
    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-base sm:text-xl font-bold text-[#131313] dark:text-white flex items-center gap-2">
          <BookOpen size={18} className="text-[#5D4037] dark:text-[#D7CCC8]" />
          Step-by-Step Solution
        </h2>
        <span class="text-xs font-mono text-[#757575] dark:text-[#A19891]">
          {solutionResult?.steps?.length || 1} Steps
        </span>
      </div>

      <div class="space-y-3">
        {solutionResult?.steps?.map((step: any, index: number) => (
          <div class="p-4 rounded-xl sm:rounded-2xl bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] space-y-2 shadow-2xs">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-[#EFEBE9] dark:bg-[#3E2723] text-[#5D4037] dark:text-[#D7CCC8] text-xs font-mono font-bold flex items-center justify-center shrink-0">
                {index + 1}
              </span>
              <h3 class="font-bold text-xs sm:text-sm text-[#131313] dark:text-white">
                {step.title}
              </h3>
            </div>
            <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] leading-relaxed pl-8">
              {step.explanation}
            </p>
            {step.math && (
              <div class="ml-8 p-2.5 rounded-lg bg-[#FAF9F5] dark:bg-[#141211] border border-[#EAE6DF] dark:border-[#2A2421] overflow-x-auto text-xs sm:text-sm">
                <Fragment set:html={renderLatex(step.math, true)} />
              </div>
            )}
            {step.rule && (
              <div class="ml-8 text-[11px] font-mono text-[#757575] dark:text-[#A19891]">
                Rule used: <span class="font-semibold text-[#5D4037] dark:text-[#D7CCC8]">{step.rule.name}</span>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Interactive Solver Widget -->
    <section class="space-y-3 pt-2">
      <div class="flex items-center justify-between">
        <h2 class="text-base sm:text-lg font-bold text-[#131313] dark:text-white flex items-center gap-2">
          <Sparkles size={16} className="text-amber-500" />
          Try It Yourself or Edit Equation
        </h2>
        <span class="text-[11px] font-mono text-[#757575] dark:text-[#A19891]">Interactive Calculator</span>
      </div>
      <div class="rounded-2xl border border-[#E0E0E0] dark:border-[#2E2825] overflow-hidden bg-white dark:bg-[#1B1B1B] p-2 sm:p-4 shadow-sm">
        <EquationSolver
          client:load
          initialMode={initialMode}
          initialEquation={problem.inputExpression}
          hideHeader
          wideLayout
        />
      </div>
    </section>

    <!-- Frequently Asked Questions -->
    {problem.faqs && problem.faqs.length > 0 && (
      <section class="space-y-3">
        <h2 class="text-base sm:text-lg font-bold text-[#131313] dark:text-white flex items-center gap-2">
          <HelpCircle size={16} className="text-[#5D4037] dark:text-[#D7CCC8]" />
          Common Questions About {problem.problemText}
        </h2>
        <div class="grid grid-cols-1 gap-3">
          {problem.faqs.map((faq) => (
            <div class="p-4 rounded-xl bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] space-y-1">
              <h3 class="text-xs sm:text-sm font-bold text-[#131313] dark:text-white">{faq.q}</h3>
              <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Related Problems Grid -->
    {relatedProblems.length > 0 && (
      <section class="space-y-3 pt-2 border-t border-[#E0E0E0] dark:border-[#2E2825]">
        <h2 class="text-base sm:text-lg font-bold text-[#131313] dark:text-white">
          Related Math Problems with Steps
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {relatedProblems.map((rel) => (
            <a
              href={`/solve/${rel.category}/${rel.slug}`}
              class="group p-3.5 rounded-xl bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] hover:border-[#5D4037] dark:hover:border-[#D7CCC8] transition-all flex items-center justify-between"
            >
              <div class="min-w-0 pr-2">
                <div class="font-bold text-xs sm:text-sm text-[#131313] dark:text-white group-hover:text-[#5D4037] dark:group-hover:text-[#D7CCC8] truncate">
                  {rel.problemText}
                </div>
                <div class="text-[11px] text-[#757575] dark:text-[#A19891] truncate mt-0.5">
                  {rel.requiredFormula.name}
                </div>
              </div>
              <ArrowRight size={14} className="text-[#757575] group-hover:text-[#5D4037] dark:group-hover:text-white shrink-0 group-hover:translate-x-0.5 transition-transform" />
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Bottom Hub Link -->
    <div class="text-center pt-4">
      <a
        href="/solve"
        class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-[#5D4037] dark:text-[#D7CCC8] hover:underline"
      >
        <ArrowLeft size={14} /> Browse all 65 solved math problems
      </a>
    </div>
  </div>
</BaseLayout>
