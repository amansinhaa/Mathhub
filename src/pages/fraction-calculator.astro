---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FractionCalculator from '@/components/calculator/FractionCalculator';
import AdBanner from '@/components/ads/AdBanner.astro';

const title = 'Fraction Calculator with Steps — Add, Multiply & Divide';
const description = 'Free fraction calculator with step-by-step working. Add, subtract, multiply, and divide fractions, improper fractions, and mixed numbers easily.';
const canonical = 'https://www.easyequate.com/fraction-calculator';

const faqs = [
  {
    q: "How do you add or subtract fractions with different denominators?",
    a: "Find the Least Common Denominator (LCD). Multiply the numerator and denominator of each fraction so they share the LCD, then add or subtract only the numerators while keeping the common denominator."
  },
  {
    q: "How do you multiply two fractions?",
    a: "Multiply the numerators together, multiply the denominators together, and simplify the resulting fraction by dividing both by their Greatest Common Divisor (GCD): (a/b) × (c/d) = (a × c) / (b × d)."
  },
  {
    q: "What is 'Keep, Change, Flip' for dividing fractions?",
    a: "To divide fractions: 1) Keep the first fraction, 2) Change the division sign to multiplication, 3) Flip the second fraction into its reciprocal. Then multiply across: (a/b) ÷ (c/d) = (a/b) × (d/c)."
  },
  {
    q: "What is an improper fraction versus a mixed number?",
    a: "An improper fraction has a numerator greater than or equal to its denominator (like 7/4). A mixed number expresses that same value as a whole number plus a proper fraction (like 1 3/4)."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "EasyEquate Fraction Calculator",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <div class="w-full text-[#131313] dark:text-[#F5F5F5] py-1">
    <div class="max-w-6xl xl:max-w-7xl mx-auto space-y-4 sm:space-y-6">
      <header class="space-y-1 sm:space-y-1.5 text-center sm:text-left pt-10 sm:pt-0 sm:pl-36 md:pl-44">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-[#EFEBE9] dark:bg-[#25201E] border border-[#D7CCC8] dark:border-[#3E2723] text-[10px] sm:text-xs font-mono font-bold text-[#5D4037] dark:text-[#D7CCC8]">
          <span>FRACTION ARITHMETIC</span>
          <span>•</span>
          <span>STEP-BY-STEP SIMPLIFICATION</span>
        </div>
        <h1 class="text-xl sm:text-2xl md:text-3xl font-bold tracking-tight text-[#131313] dark:text-white">
          Fraction Calculator with Steps
        </h1>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] max-w-3xl">
          Add, subtract, multiply, and divide fractions with full working steps. Automatically simplifies to lowest terms and displays mixed numbers and decimal equivalents.
        </p>
      </header>

      <section class="w-full">
        <FractionCalculator client:load />
      </section>

      <AdBanner />

      <section class="bg-white dark:bg-[#1B1B1B] p-4 sm:p-6 rounded-2xl border border-[#E0E0E0] dark:border-[#2E2825] shadow-xs space-y-3">
        <h2 class="text-base sm:text-lg font-bold text-[#131313] dark:text-white">How Fraction Operations Work</h2>
        <p class="text-xs sm:text-sm text-[#616161] dark:text-[#A19891] leading-relaxed">
          Fractions represent parts of a whole where the top number (numerator) represents the number of parts taken, and the bottom number (denominator) represents the total number of equal parts. When adding or subtracting, denominators must match because you cannot combine parts of different sizes. When multiplying or dividing, proportions scale directly across both dimensions.
        </p>
      </section>

      <section class="space-y-3 sm:space-y-4">
        <h2 class="text-base sm:text-xl font-bold text-[#131313] dark:text-white">Frequently Asked Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {faqs.map(faq => (
            <div class="p-3 sm:p-4 rounded-xl sm:rounded-2xl bg-white dark:bg-[#1B1B1B] border border-[#E0E0E0] dark:border-[#2E2825] space-y-1.5">
              <h3 class="text-xs sm:text-sm font-bold text-[#131313] dark:text-white">{faq.q}</h3>
              <p class="text-xs text-[#616161] dark:text-[#A19891] leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <footer class="text-center space-y-4 pt-8 border-t border-[#E0E0E0] dark:border-[#5D4037]">
        <h3 class="text-xl font-medium">Explore Related Calculators</h3>
        <div class="flex flex-wrap justify-center gap-4 text-sm">
          <a href="/percentage-calculator" class="text-blue-600 dark:text-blue-400 hover:underline">Percentage Calculator</a>
          <a href="/gcd-lcm-calculator" class="text-blue-600 dark:text-blue-400 hover:underline">GCD & LCM Calculator</a>
          <a href="/equation-solver-with-steps" class="text-blue-600 dark:text-blue-400 hover:underline">Equation Solver</a>
          <a href="/calculator" class="text-blue-600 dark:text-blue-400 hover:underline">Scientific Calculator</a>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>
