---
import 'katex/dist/katex.min.css';
import '../styles/globals.css';
import { ThemeToggle } from '../components/layout/ThemeToggle';
import { Navbar } from '../components/layout/Navbar';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  jsonLd?: any;
}

const {
  title = 'EasyEquate — Free Online Step-by-Step Math Solvers & Calculators',
  description = 'EasyEquate is a free step-by-step math solver and calculator platform featuring scientific calculations, algebra, calculus, 2D graph plotting, and formula sheets.',
  canonical = Astro.url.href,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(canonical, 'https://www.easyequate.com').href;
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'EasyEquate',
  alternateName: ['EasyEquate'],
  url: 'https://www.easyequate.com',
  image: 'https://www.easyequate.com/logo.png',
  logo: 'https://www.easyequate.com/logo.png',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description: description,
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-MJQ8M6GD');
    </script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.easyequate.com/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.easyequate.com/og-image.png" />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Google tag (gtag.js) with Anti-Bot Gating -->
    <script is:inline>
      (function () {
        // Prevent headless browsers, automated drivers, and known crawler bots from firing GA
        var isBot = Boolean(
          navigator.webdriver ||
          window.__nightmare ||
          window.callPhantom ||
          window._phantom ||
          /bot|googlebot|crawler|spider|robot|crawling|slurp|facebookexternalhit|lighthouse|headless|bytespider|gptbot|bingbot|yandex|duckduckbot/i.test(
            navigator.userAgent || ''
          )
        );

        if (isBot) return;

        // Dynamically inject GA4 only for real human visitors
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-8F7L0PRB5N';
        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-8F7L0PRB5N');
      })();
    </script>

    <!-- Google AdSense -->
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2475081427029279"
      crossorigin="anonymous"
    ></script>

    <!-- Microsoft Clarity (Bing Webmaster Tools) -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "ygd66u8sz3");
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Anti-FOUC Theme Script -->
    <script is:inline>
      try {
        var raw = localStorage.getItem('mathhub-theme-mode');
        var theme = 'system';
        if (raw) {
          var p = JSON.parse(raw);
          if (p && p.state && p.state.theme) {
            theme = p.state.theme;
          }
        } else {
          var old = localStorage.getItem('mathhub-theme');
          if (old) {
            var op = JSON.parse(old);
            if (op && op.state && op.state.theme) {
              theme = op.state.theme;
            }
          }
        }
        var isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (e) {}
    </script>

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd || defaultJsonLd)} />
  </head>
  <body class="font-sans bg-white dark:bg-[#131313] text-[#131313] dark:text-[#F5F5F5] antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MJQ8M6GD"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <div class="relative flex h-dvh min-h-screen flex-col overflow-hidden bg-[#FAFAFA] dark:bg-[#131313] transition-colors duration-150">
      <!-- Single Universal Top-Right Theme Toggle Island -->
      <div class="fixed top-3 right-3 z-50">
        <ThemeToggle client:load className="p-2 rounded-xl bg-white/95 dark:bg-[#1B1B1B]/95 backdrop-blur-md border border-[#E0E0E0] dark:border-[#2E2825] shadow-md hover:bg-[#F5F5F5] dark:hover:bg-[#252322]" />
      </div>

      <!-- Main content area -->
      <main class="flex-1 overflow-y-auto min-h-0 flex flex-col justify-between">
        <div class="mx-auto max-w-7xl px-3 sm:px-6 py-3 sm:py-5 w-full flex-1">
          <slot />
        </div>
        <Footer />
      </main>

      <!-- Navigation Drawer Island -->
      <Navbar client:load currentPath={currentPath} />
    </div>
  </body>
</html>
