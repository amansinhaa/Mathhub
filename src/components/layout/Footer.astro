---
import { Calculator, BookOpen, GraduationCap, ShieldCheck } from 'lucide-react';

const SOLVERS = [
  { label: 'Scientific Calculator', href: '/calculator' },
  { label: 'Percentage Calculator', href: '/percentage-calculator' },
  { label: 'Fraction Calculator', href: '/fraction-calculator' },
  { label: 'GCD & LCM Calculator', href: '/gcd-lcm-calculator' },
  { label: '2D Graph Plotter', href: '/graph' },
  { label: 'Quadratic Equation Solver', href: '/quadratic-equation-solver' },
  { label: 'Domain & Range Calculator', href: '/domain-and-range-calculator' },
  { label: 'Polynomial & Equation Solver', href: '/equation-solver-with-steps' },
  { label: 'Matrix Calculator & Solver', href: '/matrix-solver' },
  { label: 'Derivative Calculator', href: '/derivative-calculator' },
  { label: 'Integral Calculator', href: '/integral-calculator' },
  { label: 'Inequality Solver', href: '/inequality-solver' },
  { label: 'System of Equations', href: '/system-of-equations' },
  { label: 'Unit & Currency Converter', href: '/unit-converter' },
];

const FORMULAS = [
  { label: 'All Formula Sheets (117)', href: '/formulas' },
  { label: 'GCSE Maths Formula Sheet', href: '/formula-sheet/gcse' },
  { label: 'A-Level Maths Formula Sheet', href: '/formula-sheet/a-level' },
  { label: 'Edexcel Maths Formula Sheet', href: '/formula-sheet/edexcel' },
  { label: 'AQA Maths Formula Sheet', href: '/formula-sheet/aqa' },
  { label: 'IGCSE Maths Formula Sheet', href: '/formula-sheet/igcse' },
  { label: 'Class 10 Maths Formula Sheet', href: '/formula-sheet/class-10' },
  { label: 'Class 12 Maths Formula Sheet', href: '/formula-sheet/class-12' },
];

const GUIDES = [
  { label: 'Solved Problems Library (65+)', href: '/solve' },
  { label: 'All Learning Guides', href: '/learn' },
  { label: 'What is a Function?', href: '/learn/what-is-a-function' },
  { label: 'How to Find Domain & Range', href: '/learn/how-to-find-domain-and-range' },
  { label: 'How to Graph a Quadratic', href: '/learn/how-to-graph-a-quadratic-function' },
  { label: 'What is a Derivative?', href: '/learn/what-is-a-derivative' },
  { label: 'Solve Simultaneous Equations', href: '/learn/how-to-solve-simultaneous-equations' },
  { label: 'How to Find Limits', href: '/learn/how-to-find-limits' },
];

const LEGAL = [
  { label: 'About EasyEquate', href: '/about' },
  { label: 'Contact Us', href: '/contact' },
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Terms of Service', href: '/terms' },
];
---

<footer class="mt-12 border-t border-[#E0E0E0] dark:border-[#2E2825] bg-white dark:bg-[#181818] text-[#131313] dark:text-[#F5F5F5] transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 lg:py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-10">
      <!-- Column 1: Math Solvers -->
      <div>
        <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[#5D4037] dark:text-[#D7CCC8] mb-3 flex items-center gap-1.5">
          <Calculator className="w-3.5 h-3.5" />
          Math Solvers
        </h3>
        <ul class="space-y-2 text-xs">
          {SOLVERS.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-[#616161] hover:text-[#5D4037] dark:text-[#A19891] dark:hover:text-white transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 2: Formula Sheets -->
      <div>
        <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[#5D4037] dark:text-[#D7CCC8] mb-3 flex items-center gap-1.5">
          <BookOpen className="w-3.5 h-3.5" />
          Formula Sheets
        </h3>
        <ul class="space-y-2 text-xs">
          {FORMULAS.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-[#616161] hover:text-[#5D4037] dark:text-[#A19891] dark:hover:text-white transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Learning Guides -->
      <div>
        <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[#5D4037] dark:text-[#D7CCC8] mb-3 flex items-center gap-1.5">
          <GraduationCap className="w-3.5 h-3.5" />
          Study Guides
        </h3>
        <ul class="space-y-2 text-xs">
          {GUIDES.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-[#616161] hover:text-[#5D4037] dark:text-[#A19891] dark:hover:text-white transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: About & Legal -->
      <div>
        <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[#5D4037] dark:text-[#D7CCC8] mb-3 flex items-center gap-1.5">
          <ShieldCheck className="w-3.5 h-3.5" />
          About & Legal
        </h3>
        <ul class="space-y-2 text-xs">
          {LEGAL.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-[#616161] hover:text-[#5D4037] dark:text-[#A19891] dark:hover:text-white transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-6 pt-4 border-t border-[#E0E0E0] dark:border-[#2E2825]">
          <p class="text-[11px] text-[#757575] dark:text-[#8D827A] leading-relaxed">
            EasyEquate is a free educational platform designed for students, teachers, and math enthusiasts worldwide.
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright Bar -->
    <div class="pt-6 border-t border-[#E0E0E0] dark:border-[#2E2825] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#757575] dark:text-[#8D827A]">
      <div class="flex items-center gap-2">
        <img src="/logo.png" alt="EasyEquate" class="w-5 h-5 rounded object-contain" />
        <span>&copy; {new Date().getFullYear()} EasyEquate. All rights reserved.</span>
      </div>
      <div class="text-[11px] font-mono text-[#8D827A] dark:text-[#A19891]">
        Free Step-by-Step Math &amp; Graphing
      </div>
    </div>
  </div>
</footer>
