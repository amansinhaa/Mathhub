---
interface Props {
  slotId?: string;
  format?: 'auto' | 'horizontal' | 'rectangle';
  className?: string;
}

const {
  slotId = '4268675734',
  format = 'auto',
  className = '',
} = Astro.props;
---

<div class={`w-full my-6 flex flex-col items-center justify-center overflow-hidden ${className}`}>
  <div class="w-full max-w-4xl min-h-[90px] flex items-center justify-center">
    <!-- EasyEquate-Horizontal-Banner -->
    <ins
      class="adsbygoogle"
      style="display:block; width:100%; text-align:center;"
      data-ad-client="ca-pub-2475081427029279"
      data-ad-slot={slotId}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      try {
        (adsbygoogle = window.adsbygoogle || []).push({});
      } catch (e) {}
    </script>
  </div>
</div>
